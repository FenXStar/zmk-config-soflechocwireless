/*
 * Sofle Choc (PandaKB, nice!nano nRF52840) keymap
 * - 2 rotary encoders, RGB underglow, SSD1306 OLEDs on both halves
 * - editable live via ZMK Studio
 * - ported from the firmware-build branch (config/sofle.keymap); the unused
 *   <dt-bindings/zmk/power_save.h> include was dropped: it does not exist in
 *   current ZMK main and no binding uses it
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        /*
         * Right encoder = real mouse wheel (&msc sends HID Generic Desktop
         * wheel events, unlike the C_AC_SCROLL_* consumer keys).
         * tap-ms must exceed &msc's 16ms tick (default 5ms produces no
         * wheel events at all): each detent holds the scroll "key" ~100ms
         * (~1 wheel notch); fast turns stack presses -> faster scrolling.
         * Sensor bindings always execute on the central (the dongle).
         */
        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
            tap-ms = <100>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";

            // ------------------------------------------------------------------------------------------------------------
            // |  `    |  1  |  2  |  3   |  4   |  5   |                         |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                         |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                         |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |        | ExtPw |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |        | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp ESCAPE  &kp N1  &kp N2    &kp N3    &kp N4     &kp N5                               &kp N6  &kp N7         &kp N8     &kp N9     &kp N0    &kp DELETE
&kp GRAVE   &kp Q   &kp W     &kp E     &kp R      &kp T                                &kp Y   &kp U          &kp I      &kp O      &kp P     &kp LEFT_BRACKET
&kp TAB     &kp A   &kp S     &kp D     &kp F      &kp G                                &kp H   &kp J          &kp K      &kp L      &kp SEMI  &kp SQT
&kp LSHFT   &kp Z   &kp X     &kp C     &kp V      &kp B   &kp C_MUTE    &kp LG(LS(S))  &kp N   &kp M          &kp COMMA  &kp DOT    &kp FSLH  &kp RIGHT_BRACKET
                    &kp LGUI  &kp LALT  &kp LCTRL  &mo 1   &kp SPACE     &kp RET        &mo 2   &kp BACKSPACE  &kp EQUAL  &kp MINUS
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&scroll_encoder>;
        };

        lower_layer {
            display-name = "Lower";

            // ------------------------------------------------------------------------------------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // | `     |   1 |   2 |   3  |   4  |   5  |                   |   6  |   7   |   8   |   9  |    0  |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |

            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5                    &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans   &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            display-name = "Raise";

            // ------------------------------------------------------------------------------------------------------------
            // |BTCLR| BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |RGB EF|RGB TG |RGB MD |RGB+  |RGB-   |PSLEEP |
            // |     | INS  | PSCR | GUI   |       |      |                |      |       |   ^   |      |       |       |
            // |     | ALT  | CTRL | SHIFT |       | CAPS |                |      |   <-  |   v   |  ->  |  DEL  | BKSPC |
            // |     | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |       |       |      |       |       |

            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                         &none          &none     &none     &none      &none  &none
&trans      &none         &rgb_ug RGB_BRD  &rgb_ug RGB_TOG  &rgb_ug RGB_BRI  &ext_power EP_TOG                    &none          &kp HOME  &kp UP    &kp END    &none  &none
&trans      &none         &none            &none            &none            &studio_unlock                       &kp PG_UP      &kp LEFT  &kp DOWN  &kp RIGHT  &none  &none
&trans      &kp K_UNDO    &kp K_CUT        &kp K_COPY       &kp K_PASTE      &none              &trans    &trans  &kp PAGE_DOWN  &none     &none     &none      &none  &none
                          &trans           &trans           &trans           &trans             &trans    &trans  &none          &trans    &none     &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
