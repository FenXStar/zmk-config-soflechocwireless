# All variants (halves, left_central fallback, dongle) are one keyboard: the
# BLE name advertised via BT DIS and shown in Studio/OS must match on every
# build. (Previously the RIGHT shield was missing here, leaving the right
# half with an empty ZMK_KEYBOARD_NAME / BT device name.)
config ZMK_KEYBOARD_NAME
	default "Sofle Choc"

if SHIELD_SOFLECHOC_LEFT || SHIELD_SOFLECHOC_RIGHT

config ZMK_SPLIT
	default y

if ZMK_DISPLAY

config I2C
	default y

config SSD1306
	default y

choice ZMK_DISPLAY_WORK_QUEUE
	default ZMK_DISPLAY_WORK_QUEUE_DEDICATED
endchoice

endif # ZMK_DISPLAY

if LVGL

config LV_Z_VDB_SIZE
	default 64

config LV_DPI_DEF
	default 148

config LV_Z_BITS_PER_PIXEL
	default 1

choice LV_COLOR_DEPTH
	default LV_COLOR_DEPTH_1
endchoice

endif # LVGL

endif

if SHIELD_SOFLECHOC_DONGLE

# ZMK_KEYBOARD_NAME default is global above (same "Sofle Choc" name).

config ZMK_SPLIT_ROLE_CENTRAL
	default y

config ZMK_SPLIT
	default y

config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
	default 2

endif
