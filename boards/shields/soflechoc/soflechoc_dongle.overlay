/*
 * Dongle build: a keyboard-less central that runs on the Prospector
 * (XIAO nRF52840 + ST7789 screen). It talks to both halves over BLE.
 *
 * The Prospector screen itself comes from the prospector_adapter shield
 * (carrefinho/prospector-zmk-module). This file still needs the pieces
 * ZMK Studio + the shared keymap require:
 * - a physical layout + matrix transform (ZMK Studio BUILD_ASSERT)
 * - sensor stubs so the keymap's sensor-bindings count matches
 * - a stub LED strip so &rgb_ug behavior references resolve; RGB commands
 *   are forwarded to the halves, the dongle drives nothing
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <layouts/josefadamcik/sofle.dtsi>
#include <dt-bindings/led/led.h>

&josefadamcik_sofle_layout {
    transform = <&default_transform>;
};

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zmk,physical-layout = &josefadamcik_sofle_layout;
        zmk,underglow = &led_strip;
    };

    mock_kscan: kscan_1 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                 RC(0,6) RC(0,7) RC(0,8)  RC(0,9) RC(0,10) RC(0,11)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                 RC(1,6) RC(1,7) RC(1,8)  RC(1,9) RC(1,10) RC(1,11)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)                 RC(2,6) RC(2,7) RC(2,8)  RC(2,9) RC(2,10) RC(2,11)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(4,5) RC(4,6) RC(3,6) RC(3,7) RC(3,8)  RC(3,9) RC(3,10) RC(3,11)
                            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11)
        >;
    };

    sensor_stub_left: sensor_stub_left {
        status = "disabled";
    };

    sensor_stub_right: sensor_stub_right {
        status = "disabled";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&sensor_stub_left &sensor_stub_right>;
        triggers-per-rotation = <20>;
    };
};

/*
 * Unused SPI instance wired to nothing: CONFIG_ZMK_RGB_UNDERGLOW needs a
 * real zmk,underglow chosen node to compile, even though the dongle has no
 * LEDs. RGB_TOG/HUE/EFF (global-locality behaviors) are forwarded to the
 * halves' real LED strips.
 *
 * SPI instance choice on XIAO nRF52840: instance 1 is TWIM1/i2c1 (enabled
 * by the board and used by the Prospector APDS-9960), instance 2 is
 * disabled by the Prospector adapter overlay, instance 3 drives the ST7789
 * screen. SPI0 is the only free one; its pins go to the unbonded NFC pads
 * (P0.02/P0.03), which nothing else uses.
 */
&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 3)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 2)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 3)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 2)>;
            low-power-enable;
        };
    };
};

&spi0 {
    compatible = "nordic,nrf-spim";
    status = "okay";

    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        reg = <0>;
        spi-max-frequency = <4000000>;
        chain-length = <1>;
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
    };
};
